# Copy this file to .env and fill in your key.
# Without a key, VibeFinder runs in offline mode (rule-based parser + template explanations).
GEMINI_API_KEY=

# Optional: which Gemini model to use (default gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash

# Optional: DEBUG, INFO, WARNING, ERROR (default INFO). Logs go to logs/vibefinder.log
VIBEFINDER_LOG_LEVEL=INFO
